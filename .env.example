# ==============================================================================
# MASTER ADS INJECTION (MAI) — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in the required verified credentials.
# Never commit .env or .env.local with real credentials to version control.
# ==============================================================================

# Canonical Production URL (Required for dynamic sitemap.xml, robots.txt, and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://masteradsinjection.com

# Contact Form Email Delivery Service (Optional: resend | smtp | webhook)
# If left empty, contact form saves lead submissions and returns configured status.
CONTACT_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_placeholder_api_key_here
CONTACT_RECIPIENT_EMAIL=contact@masteradsinjection.com
CONTACT_SENDER_EMAIL=leads@masteradsinjection.com

# Optional SMTP Configuration (if CONTACT_EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_USER=smtp_username_here
SMTP_PASSWORD=smtp_password_here
SMTP_SECURE=false

# Webhook Endpoint (if CONTACT_EMAIL_PROVIDER=webhook, e.g. Zapier, Make, Slack, CRM)
CONTACT_WEBHOOK_URL=

# Tracking & Analytics Identifiers (Optional: Leave blank to disable tags until configured)
# Tags will only fire when the visitor provides analytics/marketing consent.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=
